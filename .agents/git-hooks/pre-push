#!/usr/bin/env bash
# pre-push — scans unattended pushes, then runs the package.json gate scripts
# (config.prepush, default typecheck + lint) before every git push.
# Installed by jplugin-agentic-development/install.sh into .git/hooks/pre-push.
# Harness-agnostic: works for manual pushes, Claude Code, Pi, and CI.
#
# Kill switch: SKIP_PREPUSH=1 git push (everything but the unattended scan)

set -uo pipefail

# git hands the pushed refs over stdin once; both the scan and the wrap-up gate read them.
PUSH_REFS=$(cat)
PUSH_REMOTE_URL="${2:-}"

# ── Unattended scan — blocks, and runs before the kill switch ────────────────
# A push of a `routine/` branch, or one a caller declares unattended with
# UNATTENDED_SCAN=1 (/yolo, /auto-push, an unattended /wrap-up-session), runs the
# deterministic ruleset over what the push adds and the session transcript.
# specs/unattended-scan.md is the contract. It runs before SKIP_PREPUSH because an
# unattended agent can set an environment variable; `git push --no-verify` stays
# the human override. Exit 1 (a high hit) and 2 (the scan could not run) both
# block: an unattended push that was not scanned must not look like one that was.
# New refs query the remote base; findings are filed by /wrap-up-session.
SCANNER=".agents/skills/wrap-up-session/scripts/unattended_scan.py"
SCAN_RULES=".agents/skills/wrap-up-session/scripts/unattended-scan-rules.json"

unattended_scan() {
  _local_ref="$1"; _local_sha="$2"; _remote_ref="$3"; _remote_sha="$4"
  case "$_local_sha" in *[!0]*) ;; *) return 0 ;; esac   # branch deletion
  if [ "${UNATTENDED_SCAN:-0}" != "1" ]; then
    case "$_local_ref $_remote_ref" in
      refs/heads/routine/*|*" refs/heads/routine/"*) ;;
      *) return 0 ;;
    esac
  fi
  # The negotiated remote tip anchors an update. A new ref queries fully
  # qualified base refs on that same server once; local refs establish no trust.
  _anchor="$_remote_sha"
  case "$_remote_sha" in
    *[!0]*) ;;
    *)
      if [ -z "$PUSH_REMOTE_URL" ] || ! _remote_heads=$(git ls-remote -- "$PUSH_REMOTE_URL" \
          refs/heads/master refs/heads/main refs/heads/develop); then
        echo "BLOCKED: unattended scan could not run — ls-remote failed for the push remote." >&2
        return 2
      fi
      _anchor=""
      for _candidate in refs/heads/master refs/heads/main refs/heads/develop; do
        while read -r _advertised_sha _advertised_ref; do
          [ "$_advertised_ref" = "$_candidate" ] || continue
          _anchor="$_advertised_sha"
          break
        done <<EOF
$_remote_heads
EOF
        [ -z "$_anchor" ] || break
      done
      if [ -z "$_anchor" ]; then
        echo "BLOCKED: unattended scan could not run — push remote has no base branch." >&2
        return 2
      fi
      ;;
  esac
  if [[ ! "$_anchor" =~ ^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]] ||
     ! git cat-file -e "$_anchor^{commit}" 2>/dev/null; then
    echo "BLOCKED: unattended scan could not run — remote anchor $_anchor is not a local commit; fetch the remote." >&2
    return 2
  fi
  # New refs use their fork point for the range; the snapshot stays at the anchor.
  # Without shared history the anchor comparison remains the wider scan.
  _base="$_anchor"
  case "$_remote_sha" in *[!0]*) ;; *) _base=$(git merge-base "$_anchor" "$_local_sha") || _base="$_anchor" ;; esac
  # This integrity check is outside the scanner/rules that it protects.
  _integrity=0
  for _protected in "$SCANNER" "$SCAN_RULES"; do
    git diff --quiet "$_base" "$_local_sha" -- "$_protected"
    case $? in
      0) ;;
      1) echo "[MUST-FIX | confidence: 100 | autofix_class: manual | owner: human] diff:$_protected:1 — check-gate-edit: edits the scanner or built-in rules." >&2; _integrity=1 ;;
      *) echo "BLOCKED: unattended scan could not inspect scanner/rule changes." >&2; return 1 ;;
    esac
  done
  _snapshot=$(mktemp -d) || return 1
  if ! git show "$_anchor:$SCANNER" > "$_snapshot/unattended_scan.py" ||
     ! git show "$_anchor:$SCAN_RULES" > "$_snapshot/unattended-scan-rules.json"; then
    rm -rf "$_snapshot"
    echo "BLOCKED: unattended scan could not run — trusted baseline lacks scanner/rules." >&2
    return 1
  fi
  # Isolated Python also keeps the pushing tree off the import path.
  python3 -I "$_snapshot/unattended_scan.py" scan --base "$_base" --head "$_local_sha" \
    --transcript "${UNATTENDED_SCAN_TRANSCRIPT:-auto}" >&2
  _scan_status=$?
  rm -rf "$_snapshot"
  [ "$_integrity" = "0" ] || _scan_status=1
  case "$_scan_status" in
    0) return 0 ;;
    1) echo "BLOCKED: unattended scan — a high-severity finding on ${_local_ref#refs/heads/} (above). A human overrides with git push --no-verify." >&2 ;;
    *) echo "BLOCKED: unattended scan could not run on ${_local_ref#refs/heads/} — an unattended push must be scanned." >&2 ;;
  esac
  return 1
}

_scan_blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  unattended_scan "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" || _scan_blocked=1
done <<EOF
$PUSH_REFS
EOF
[ "$_scan_blocked" = "0" ] || exit 1

[ "${SKIP_PREPUSH:-0}" = "1" ] && exit 0

# Block force pushes unless explicitly allowed.
for arg in "$@"; do
  if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
    if [ "${ALLOW_FORCE_PUSH:-0}" != "1" ]; then
      echo "BLOCKED: force push. Set ALLOW_FORCE_PUSH=1 to override." >&2
      exit 1
    fi
  fi
done

# Gate scripts. A project makes its gates mandatory by naming them in package.json:
#   "config": { "prepush": ["type-check", "lint", "test:fast"] }
# The hook then runs exactly those scripts, in order. A declared gate with no
# script of that name BLOCKS — a rename can never quietly drop a step.
# Undeclared, the defaults apply: `type-check` (else `typecheck`) then `lint`,
# each run only when package.json has a script of that name. A default gate with
# no script is warned about, never silent: declaring config.prepush makes it block.
#
# The resolver owns every decision: it prints the scripts to run on stdout, its
# own BLOCKED lines on stderr, and exits non-zero when the push must stop.
# hasOwnProperty, not `in`: `constructor` is "in" every object.
RESOLVE_GATES='
const fail = (msg) => { console.error("BLOCKED: " + msg); process.exit(2); };
let pkg;
try { pkg = JSON.parse(require("fs").readFileSync("package.json", "utf8")); }
catch (e) { fail("cannot read the pre-push gates from package.json: " + e.message); }
const scripts = (pkg && pkg.scripts) || {};
const has = (name) => Object.prototype.hasOwnProperty.call(scripts, name);
const declared = pkg && pkg.config && pkg.config.prepush;
if (declared !== undefined) {
  if (!Array.isArray(declared) || declared.length === 0
      || !declared.every((n) => typeof n === "string" && n !== "" && !/[\n\r]/.test(n))) {
    fail("package.json config.prepush must be a non-empty array of script names.");
  }
  const missing = declared.filter((n) => !has(n));
  for (const n of missing) {
    console.error("BLOCKED: package.json config.prepush declares \"" + n + "\", but no script has that name. Renamed it? Rename it in config.prepush too.");
  }
  if (missing.length) process.exit(2);
  declared.forEach((n) => console.log(n));
} else {
  for (const group of [["type-check", "typecheck"], ["lint"]]) {
    const found = group.find(has);
    if (found) console.log(found);
    else console.error("[pre-push] WARNING: no " + group.join("/") + " script in package.json \u2014 that gate is NOT running. Declare config.prepush to make a missing gate block.");
  }
}'

# Without node nothing can be resolved or run. The push blocks when package.json
# declares config.prepush or has any default gate script (type-check, typecheck,
# lint): letting it through would run no checks at all. A package.json with
# neither has no gate to run, so the push goes on.
if [ -f package.json ] && ! command -v node >/dev/null 2>&1; then
  if grep -q '"prepush"' package.json; then
    echo "BLOCKED: package.json declares config.prepush but node is not on PATH, so the pre-push gates cannot run." >&2
    exit 1
  fi
  if grep -Eq '"(type-check|typecheck|lint)"[[:space:]]*:' package.json; then
    echo "BLOCKED: package.json has default gate scripts (type-check/typecheck/lint) but node is not on PATH, so the pre-push gates cannot run." >&2
    exit 1
  fi
  echo "[pre-push] node is not on PATH — package.json has no default gate scripts, nothing to run." >&2
elif [ -f package.json ]; then
  GATES=$(node -e "$RESOLVE_GATES") || exit 1
  GIT_LOCAL_VARS=$(git rev-parse --local-env-vars) || exit 1

  while IFS= read -r script; do
    [ -n "$script" ] || continue
    # The log path takes nothing from package.json, so no script name can steer it.
    log=$(mktemp "${TMPDIR:-/tmp}/prepush-XXXXXX") || exit 1
    echo "[pre-push] running: npm run $script"
    # </dev/null: the script must not read this loop's input and swallow gates.
    # The subshell drops the pushing repo's GIT_DIR and friends (exported to hooks
    # from a linked worktree): a gate that runs git — a test fixture — would
    # otherwise write to this repository and push to its origin.
    if ! ( unset $GIT_LOCAL_VARS; npm run --silent "$script" ) </dev/null >"$log" 2>&1; then
      echo "BLOCKED: npm run $script failed. See $log" >&2
      tail -30 "$log" >&2
      # A worktree sharing another checkout's node_modules gets errors from
      # that tree's packages, not this branch's lockfile. Still a block: a
      # stale install can hide a real error as easily as it invents one.
      if [ -L node_modules ]; then
        echo "  note: node_modules is a symlink to $(readlink node_modules)." >&2
        echo "        If the errors name missing or outdated packages rather than your code, install" >&2
        echo "        this worktree's own tree and push again: rm node_modules && npm ci" >&2
        echo "        (rm on the symlink removes only the link, never the shared tree)." >&2
      fi
      exit 1
    fi
    rm -f "$log"
  done <<GATES_EOF
$GATES
GATES_EOF
fi

# ── Wrap-up coverage gate — warns and records, never blocks ──────────────────
# Every code-producing session converges on a push, so this is the one place a
# missing /wrap-up-session is observable regardless of which skill ran, or none.
#
# Evidence is the fingerprint /wrap-up-session § Task register writes to tasks/todo.md:
#   ## Session Summary — [YYYY-MM-DD] [a1b2c3f..d4e5f6a]
#
# The gate does no network I/O and reaches no tracker: it runs on every push,
# including offline and in CI, and external task creation needs an approval
# floor no hook can satisfy. It records debt locally; the session-start banner
# surfaces it to a human who can file it.
#
# Kill switch: SKIP_WRAPUP_GATE=1 git push
LEDGER="tasks/wrap-up-debt.md"

# Non-doc file in this commit? Documentation-only commits need no wrap-up.
touches_code() {
  _files=$(git diff-tree --no-commit-id --name-only -r "$1" 2>/dev/null) || return 1
  [ -n "$_files" ] || return 1
  while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    # Literal alternatives, not a variable: `case` parses `|` before expanding,
    # so a pattern list held in a variable collapses into one literal pattern
    # and silently classifies every file as code.
    case "$_f" in
      *.md|LICENSE|LICENSE.*|.gitignore|tasks/*) continue ;;
      *) return 0 ;;
    esac
  done <<EOF
$_files
EOF
  return 1
}

# The wrap-up commit records a range ending before itself, so it can never be
# inside its own fingerprint. Recognise it by the line it adds.
introduces_summary() {
  git diff-tree -p --no-commit-id -r "$1" -- tasks/todo.md 2>/dev/null \
    | grep -q '^+## Session Summary'
}

# resolve_base <sha> — the commit this push's range is measured from.
#
# origin/<base> is tried before the local <base>. The remote-tracking ref is the
# authority for "already on the target branch"; a local `master` that has not been
# updated is not that branch's tip, and every commit it wrongly adds to the range
# is recorded as uncovered debt. Observed 2026-10-25: a local master 192 commits
# behind origin/master turned a 10-commit branch into a 76-commit debt entry.
#
# Still no network: this reads whatever origin/<base> already points at, so a
# remote-tracking ref left stale under-reports coverage rather than over-reporting
# debt — the safe direction for a gate that only warns. `git fetch` before pushing
# is what keeps it current, and nothing here can do that for you.
resolve_base() {
  for _b in master main develop; do
    if git show-ref --verify --quiet "refs/remotes/origin/$_b"; then
      git merge-base "origin/$_b" "$1" 2>/dev/null && return 0
    fi
  done
  for _b in master main develop; do
    if git show-ref --verify --quiet "refs/heads/$_b"; then
      git merge-base "$_b" "$1" 2>/dev/null && return 0
    fi
  done
  return 1
}

wrapup_gate() {
  _local_ref="$1"; _local_sha="$2"; _remote_sha="$3"

  case "$_local_sha" in *[!0]*) ;; *) return 0 ;; esac   # branch deletion

  case "$_remote_sha" in
    *[!0]*) _range="$_remote_sha..$_local_sha" ;;
    *) _base=$(resolve_base "$_local_sha") || return 0
       _range="$_base..$_local_sha" ;;
  esac

  # A repo without tasks/todo.md does not use this workflow. Stay silent.
  _todo=$(git show "$_local_sha:tasks/todo.md" 2>/dev/null) || return 0

  _code=""
  for _c in $(git rev-list --no-merges "$_range" 2>/dev/null); do
    touches_code "$_c" || continue
    introduces_summary "$_c" && continue
    _code="$_code $_c"
  done
  [ -n "$_code" ] || return 0

  # Fingerprints. An endpoint that is not a real commit is named, never trusted:
  # silently ignoring it would let a typo widen coverage to everything.
  _covered=""
  for _fp in $(printf '%s\n' "$_todo" \
                 | grep -oE '^## Session Summary.*\[[^]]*\]' \
                 | grep -oE '\[[^]]*\]'); do
    _fp=${_fp#[}; _fp=${_fp%]}
    # The heading carries the date in its own brackets (`— [YYYY-MM-DD] [a..b]`):
    # not a fingerprint, and not a typo worth naming on every push.
    case "$_fp" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) continue ;; esac
    _start=${_fp%%..*}; _end=${_fp##*..}
    # Endpoints must be bare hex before they reach git. tasks/todo.md is
    # attacker-controllable in any repo you clone, and an endpoint beginning
    # with `-` would otherwise arrive at git as an option rather than a rev.
    # Validate at the trust boundary, not after.
    if [ "$_start" = "$_fp" ] || [ -z "$_start" ] || [ -z "$_end" ] \
       || ! printf '%s' "$_start" | grep -qE '^[0-9a-fA-F]{4,40}$' \
       || ! printf '%s' "$_end" | grep -qE '^[0-9a-fA-F]{4,40}$' \
       || ! git rev-parse --verify --quiet "$_start^{commit}" >/dev/null \
       || ! git rev-parse --verify --quiet "$_end^{commit}" >/dev/null; then
      echo "[pre-push] wrap-up gate: unparseable session fingerprint [$_fp] — ignored for coverage" >&2
      continue
    fi
    _covered="$_covered $(git rev-parse "$_start") $(git rev-list "$_start..$_end" 2>/dev/null)"
  done

  _uncovered=""
  for _c in $_code; do
    # Word-split, never a `case` pattern over the whole list: rev-list's
    # newlines and the spaces between fingerprints both delimit here, so no
    # producer has to know the delimiter. (A `case` word is not field-split,
    # and a space-bounded pattern missed every commit of a multi-commit range.)
    for _k in $_covered; do [ "$_k" = "$_c" ] && continue 2; done
    _uncovered="$_uncovered $(git rev-parse --short "$_c")"
  done
  [ -n "$_uncovered" ] || return 0

  _uncovered=${_uncovered# }
  _branch=${_local_ref#refs/heads/}
  _first=${_uncovered##* }; _last=${_uncovered%% *}   # rev-list is newest-first

  echo "[pre-push] WRAP-UP GAP: pushing code commits no /wrap-up-session covers:" >&2
  echo "             $_uncovered" >&2
  echo "           Recorded in $LEDGER. Close it by running /wrap-up-session." >&2
  echo "           Intentional? SKIP_WRAPUP_GATE=1 git push" >&2

  _key="## $_branch $_first..$_last"
  if [ ! -f "$LEDGER" ]; then
    mkdir -p "$(dirname "$LEDGER")"
    {
      echo "# Wrap-Up Debt"
      echo
      echo "> Recorded by the pre-push wrap-up gate: pushes carrying code commits that"
      echo "> no \`/wrap-up-session\` run covers. File them as issues with"
      echo "> \`/task-registry upsert <id> --title <heading> --apply --approve\` (the"
      echo "> session-start banner prints the exact command), then delete the entry."
    } > "$LEDGER"
  fi
  # Idempotent: one entry per range, however many times it is re-pushed.
  # Without this the ledger grows an entry per `git push` and becomes noise.
  if ! grep -qF "$_key" "$LEDGER"; then
    {
      echo
      echo "$_key"
      echo "- Recorded: $(date +%Y-%m-%d)"
      echo "- Uncovered commits: $(printf '%s' "$_uncovered" | wc -w | tr -d ' ')"
    } >> "$LEDGER"
  fi
}

if [ "${SKIP_WRAPUP_GATE:-0}" != "1" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    wrapup_gate "$local_ref" "$local_sha" "$remote_sha"
  done <<EOF
$PUSH_REFS
EOF
fi

exit 0
