# Deployment verification state — per-session, not committed
tasks/deploy-state.json

# Session-start template drift-check cache (per-clone, not committed)
.claude/.sync-check-cache
.claude/sync-check-dismissed

# Personal, per-project Claude Code overrides — gitignored by convention.
# Imported by CLAUDE.md alongside .claude/project.md (committed, team-shared).
# Use this file for personal shortcuts, local paths, and experimental preferences.
CLAUDE.local.md

# Visual recap output — transient, regenerated per branch.
tasks/recaps/

# Graphify code graph — machine-local, regenerated by the git re-index hook.
# install.sh wires graphify when the CLI is present, which creates this here.
graphify-out/

# Python bytecode from skill scripts
__pycache__/
*.pyc
