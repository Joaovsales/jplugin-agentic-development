#!/bin/bash
# tests/fixtures/task-registry/gh — a stand-in for the GitHub CLI.
#
# The GitHub adapter shells out to `gh api` with argv-style arguments. This mock
# is put first on PATH so the adapter's real command construction is exercised:
# it records every invocation to $GH_MOCK_LOG and answers reads from canned JSON
# in $GH_MOCK_DIR. Writes are recorded, never performed — except that a created
# label is appended to labels.json, so a test can see the vocabulary grow.
#
# It is deliberately strict where the real CLI — and the REST API behind it —
# is strict:
#   * `api` takes exactly one path; the method comes from `--method`, and a
#     payload only from `--input -` (stdin). `-f`/`-F` fields are refused, so
#     an adapter that regresses to argv payloads is caught here;
#   * a path naming any repository but the fixture's answers 404, the way the
#     real API does for a repository the token cannot see;
#   * a write naming a label absent from labels.json exits 1. The real
#     `POST /issues` would silently CREATE it, which is exactly the vocabulary
#     mutation the adapter's known-label filter exists to prevent, so the mock
#     fails loudly where the API would fail quietly;
#   * positionals of the remaining subcommands are read after `--`, the way
#     cobra parses them.
#
# The log line of an `api` call is the argv line followed by the parsed stdin
# body, re-serialized with sorted keys, so a test asserts on what was SENT —
# `"labels": ["in-progress"]` — not only on which route was hit.
#
# Knobs (env):
#   GH_MOCK_DIR         directory holding issues.json / labels.json / issue-<n>.json
#   GH_MOCK_LOG         file every invocation is appended to, one line per call
#   GH_MOCK_UNAUTH      when set, `gh api user` fails like a logged-out CLI
#   GH_MOCK_FAIL        when set, every write exits 1 (partial-failure tests)
#   GH_MOCK_FAIL_ROUTE  a route under the repository (`issues/42/labels`) whose
#                       writes alone exit 1, so a test can fail the second call
#                       of a two-call write and leave the first one standing
set -u

: "${GH_MOCK_DIR:=.}"
: "${GH_MOCK_LOG:=/dev/null}"

argv_line="$*"
subcommand="${1:-}"

# ---------------------------------------------------------------- gh api -----
# `gh api [--method M] <path> [--input -]`. The route table lives in Python so
# that paging, lookups, body validation and the log line read as one dispatcher
# rather than a tangle of `case` arms and `jq`-less JSON handling.
if [ "$subcommand" = "api" ]; then
  shift
  method="GET"
  path=""
  body=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --method|-X)
        method="${2:-}"; shift 2 ;;
      --input)
        if [ "${2:-}" != "-" ]; then
          echo "gh mock: --input takes '-' (stdin) only, got '${2:-}'" >&2
          exit 1
        fi
        body="$(cat)"; shift 2 ;;
      -f|-F|--field|--raw-field)
        echo "gh mock: $1 is refused -- payloads travel on stdin through --input -" >&2
        exit 1 ;;
      -*)
        echo "gh mock: unknown api flag $1" >&2
        exit 1 ;;
      *)
        if [ -n "$path" ]; then
          echo "gh mock: api takes one path, got '$path' and '$1'" >&2
          exit 1
        fi
        path="$1"; shift ;;
    esac
  done
  if [ -z "$path" ]; then
    echo "gh mock: api needs a path" >&2
    exit 1
  fi
  GH_MOCK_BODY="$body" GH_MOCK_ARGV="$argv_line" python3 - "$method" "$path" "$GH_MOCK_DIR" "$GH_MOCK_LOG" <<'PY'
import io, json, os, re, sys
from urllib.parse import parse_qs, urlsplit

method, raw_path, data, log = sys.argv[1].upper(), sys.argv[2], sys.argv[3], sys.argv[4]
REPO = "fixture-owner/fixture-repo"
split = urlsplit(raw_path)
path = split.path.strip("/")
query = {key: values[-1] for key, values in parse_qs(split.query).items()}

raw_body = os.environ.get("GH_MOCK_BODY", "")
body = None
if raw_body.strip():
    try:
        body = json.loads(raw_body)
    except ValueError as exc:
        sys.stderr.write(f"gh mock: --input body is not JSON ({exc})\n")
        sys.exit(1)

# The log line is written before dispatch so that a refused route is recorded
# too: a test asserting "nothing was written" reads this log.
line = os.environ.get("GH_MOCK_ARGV", "")
if body is not None:
    line += " " + json.dumps(body, sort_keys=True)
with io.open(log, "a", encoding="utf-8") as handle:
    handle.write(line + "\n")


def fail(status, message):
    sys.stderr.write(f"HTTP {status}: {message} (https://api.github.com/{path})\n")
    sys.exit(1)


def load(name, default=None):
    try:
        return json.loads(io.open(os.path.join(data, name), encoding="utf-8").read())
    except (IOError, ValueError):
        if default is None:
            raise
        return default


def save(name, payload):
    io.open(os.path.join(data, name), "w", encoding="utf-8", newline="\n").write(json.dumps(payload))


def page(entries):
    """GitHub paging: `per_page` (default 30, max 100) and 1-based `page`."""
    size = min(int(query.get("per_page", 30)), 100)
    number = int(query.get("page", 1))
    return entries[(number - 1) * size:number * size]


def answer(payload):
    sys.stdout.write(json.dumps(payload))
    sys.exit(0)


def require_body(*keys):
    if body is None:
        sys.stderr.write(f"gh mock: {method} {path} needs a JSON body on stdin\n")
        sys.exit(1)
    for key in keys:
        if key not in body:
            sys.stderr.write(f"gh mock: {method} {path} body lacks {key!r}: {json.dumps(body)}\n")
            sys.exit(1)
    return body


def require_known_labels(labels):
    known = {entry["name"] for entry in load("labels.json", default=[])}
    for label in labels:
        if label not in known:
            sys.stderr.write(
                f"gh mock: label {label!r} is not in labels.json -- the adapter must filter "
                "unknown labels before a write, since the real API would create it\n"
            )
            sys.exit(1)


def issue_url(number):
    return f"https://github.com/{REPO}/issues/{number}"


if path == "user":
    if method != "GET":
        fail(404, "Not Found")
    if os.environ.get("GH_MOCK_UNAUTH"):
        fail(401, "Bad credentials")
    answer({"login": "fixture-user"})

match = re.fullmatch(r"repos/([^/]+/[^/]+)(?:/(.*))?", path)
if not match:
    fail(404, "Not Found")
if match.group(1).lower() != REPO:
    fail(404, "Not Found")
route = match.group(2) or ""

if method == "GET":
    if body is not None:
        sys.stderr.write(f"gh mock: GET {path} does not take a body\n")
        sys.exit(1)
    if route == "issues":
        entries = load("issues.json")
        state = query.get("state", "open")
        if state != "all":
            entries = [entry for entry in entries if (entry.get("state") or "open").lower() == state]
        answer(page(entries))
    found = re.fullmatch(r"issues/(\d+)", route)
    if found:
        number = found.group(1)
        single = load(f"issue-{number}.json", default={})
        if single:
            answer(single)
        # One issue is visible through both reads upstream, so a fixture that
        # declared it in issues.json has declared it for the single read too.
        for entry in load("issues.json", default=[]):
            if str(entry.get("number")) == number:
                answer(entry)
        fail(404, "Not Found")
    if route == "labels":
        answer(page(load("labels.json")))

if method in ("POST", "PATCH"):
    if os.environ.get("GH_MOCK_FAIL") or os.environ.get("GH_MOCK_FAIL_ROUTE", "\0") == route:
        fail(403, "Resource not accessible by integration")
    if method == "POST" and route == "issues":
        payload = require_body("title", "body")
        require_known_labels(payload.get("labels") or [])
        counter = os.path.join(data, "next-number")
        number = int(io.open(counter, encoding="utf-8").read().strip()) if os.path.exists(counter) else 100
        io.open(counter, "w", encoding="utf-8").write(str(number + 1))
        answer({"number": number, "html_url": issue_url(number), "state": "open"})
    found = re.fullmatch(r"issues/(\d+)", route)
    if found and method == "PATCH":
        payload = require_body()
        answer({"number": int(found.group(1)), "html_url": issue_url(found.group(1)),
                "state": payload.get("state", "open")})
    found = re.fullmatch(r"issues/(\d+)/labels", route)
    if found and method == "POST":
        payload = require_body("labels")
        require_known_labels(payload["labels"])
        answer([{"name": name} for name in payload["labels"]])
    found = re.fullmatch(r"issues/(\d+)/comments", route)
    if found and method == "POST":
        require_body("body")
        answer({"id": 1, "html_url": issue_url(found.group(1)) + "#issuecomment-1"})
    if method == "POST" and route == "labels":
        payload = require_body("name")
        entries = load("labels.json", default=[])
        if any(entry["name"] == payload["name"] for entry in entries):
            fail(422, "Validation Failed (already_exists)")
        entries.append({"name": payload["name"]})
        save("labels.json", entries)
        answer({"name": payload["name"]})

sys.stderr.write(f"gh mock: unhandled api route: {method} {raw_path}\n")
sys.exit(1)
PY
  exit $?
fi

printf '%s\n' "$argv_line" >> "$GH_MOCK_LOG"

action="${2:-}"
shift 2 2>/dev/null || true

# Split the remainder the way cobra does: flags until `--`, positionals after.
positionals=()
json_fields=""
labels=()
seen_separator=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --)
      seen_separator=1
      shift
      while [ "$#" -gt 0 ]; do positionals+=("$1"); shift; done
      ;;
    --label|--add-label)
      labels+=("${2:-}")
      shift 2
      ;;
    --json)
      json_fields="${2:-}"
      shift 2
      ;;
    --*)
      # Every flag this adapter passes takes a value except --json's siblings;
      # peeking at the next argument keeps the mock indifferent to which.
      if [ "${2:-}" = "" ] || [ "${2:0:2}" = "--" ]; then shift; else shift 2; fi
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

label_exists() {
  grep -q "\"$1\"" "$GH_MOCK_DIR/labels.json" 2>/dev/null
}

reject_unknown_labels() {
  local label
  for label in ${labels+"${labels[@]}"}; do
    if ! label_exists "$label"; then
      echo "could not add label: '$label' not found" >&2
      exit 1
    fi
  done
}

case "$subcommand" in
  repo)
    echo "fixture-owner/fixture-repo"
    exit 0
    ;;
  label)
    case "$action" in
      list)
        cat "$GH_MOCK_DIR/labels.json"
        exit 0
        ;;
      create)
        [ -n "${GH_MOCK_FAIL:-}" ] && { echo "HTTP 403: Resource not accessible" >&2; exit 1; }
        name="${positionals[0]:-}"
        [ -z "$name" ] && { echo "gh mock: label create needs a name" >&2; exit 1; }
        label_exists "$name" && { echo "label already exists" >&2; exit 1; }
        python3 - "$GH_MOCK_DIR/labels.json" "$name" <<'PY'
import io, json, sys
path, name = sys.argv[1], sys.argv[2]
entries = json.loads(io.open(path, encoding="utf-8").read())
entries.append({"name": name})
io.open(path, "w", encoding="utf-8", newline="\n").write(json.dumps(entries))
PY
        echo "https://github.com/fixture-owner/fixture-repo/labels/$name"
        exit 0
        ;;
    esac
    ;;
  issue)
    case "$action" in
      list)
        # Real `gh` validates --json names client-side and fails the WHOLE query on
        # an unknown one, rather than omitting the field. `unknown-fields` (one name
        # per line) makes a too-old gh reproducible.
        if [ -f "$GH_MOCK_DIR/unknown-fields" ]; then
          while IFS= read -r unknown; do
            [ -n "$unknown" ] || continue
            case ",$json_fields," in
              *",$unknown,"*)
                echo "Unknown JSON field: \"$unknown\"" >&2
                exit 1
                ;;
            esac
          done < "$GH_MOCK_DIR/unknown-fields"
        fi
        cat "$GH_MOCK_DIR/issues.json"
        exit 0
        ;;
      view)
        number="${positionals[0]:-}"
        if [ "$seen_separator" != "1" ]; then
          echo "gh mock: issue view got a positional without a '--' separator" >&2
          exit 1
        fi
        if [ -f "$GH_MOCK_DIR/issue-$number.json" ]; then
          cat "$GH_MOCK_DIR/issue-$number.json"
          exit 0
        fi
        # One issue is visible through both reads upstream, so a fixture that
        # declared it in issues.json has declared it for `view` too. Without this
        # the mock answers "no such issue" for an issue the same mock lists.
        if python3 - "$GH_MOCK_DIR/issues.json" "$number" <<'VIEW_PY'; then
import io, json, sys
try:
    entries = json.loads(io.open(sys.argv[1], encoding="utf-8").read())
except (IOError, ValueError):
    sys.exit(1)
for entry in entries:
    if str(entry.get("number")) == sys.argv[2]:
        sys.stdout.write(json.dumps(entry))
        sys.exit(0)
sys.exit(1)
VIEW_PY
          exit 0
        fi
        echo "could not find issue #$number" >&2
        exit 1
        ;;
      create)
        [ -n "${GH_MOCK_FAIL:-}" ] && { echo "HTTP 422: Validation Failed" >&2; exit 1; }
        reject_unknown_labels
        number="$(( $(cat "$GH_MOCK_DIR/next-number" 2>/dev/null || echo 100) ))"
        echo "$(( number + 1 ))" > "$GH_MOCK_DIR/next-number"
        echo "https://github.com/fixture-owner/fixture-repo/issues/$number"
        exit 0
        ;;
      edit|close|comment)
        [ -n "${GH_MOCK_FAIL:-}" ] && { echo "HTTP 403: Resource not accessible" >&2; exit 1; }
        reject_unknown_labels
        exit 0
        ;;
    esac
    ;;
esac

echo "gh mock: unhandled invocation: $subcommand $action ${positionals[*]:-}" >&2
exit 1
