@@ -1,10 +1,33 @@
 from datetime import datetime, timezone
 
 from app.db import db
 from app.models import Invite, Membership
 
 
 class InviteError(Exception):
     pass
 
 
+def redeem_invite(code, user_id):
+    invite = db.query(Invite).filter_by(code=code).one_or_none()
+    if invite is None:
+        raise InviteError("unknown invite code")
+    if invite.redeemed_at is not None:
+        raise InviteError("invite already used")
+    if invite.expires_at < datetime.now(timezone.utc):
+        raise InviteError("invite expired")
+
+    invite.redeemed_at = datetime.now(timezone.utc)
+    invite.redeemed_by = user_id
+    db.add(Membership(team_id=invite.team_id, user_id=user_id, role=invite.role))
+    db.commit()
+    return invite.team_id
+
+
+def pending_invites(team_id):
+    return (
+        db.query(Invite)
+        .filter_by(team_id=team_id, redeemed_at=None)
+        .order_by(Invite.expires_at)
+        .all()
+    )
