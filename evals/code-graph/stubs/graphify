#!/usr/bin/env python3
"""Four CLI faults selected by the case's fixed seed, without external services."""
import os
from pathlib import Path
import sys
import time

mode = int(os.environ["CODE_GRAPH_SEED"]) % 4
if mode == 0:
    print("graph unavailable", file=sys.stderr)
    sys.exit(1)
if mode == 1:
    time.sleep(60)
elif mode == 3:
    graph = Path("graphify-out/graph.json")
    graph.parent.mkdir(parents=True, exist_ok=True)
    graph.write_text("{broken\n", encoding="utf-8")
